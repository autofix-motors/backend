/// Servicio del catálogo: los trabajos que el taller ofrece siempre (cambio de
/// aceite, afinamiento…), para no escribirlos a mano en cada orden. Su precio
/// es una referencia: al agregarlo a una orden se copia y ahí se puede ajustar.
model Servicio {
  servicioId     String  @id @default(uuid()) @map("servicio_id") @db.Uuid
  nombre         String  @unique @db.VarChar(120)
  descripcion    String?
  /// Precio de mano de obra referencial, en soles.
  precioManoObra Decimal @map("precio_mano_obra") @db.Decimal(10, 2)
  /// Inactivo: deja de ofrecerse. Usado en una orden, la base no deja borrarlo.
  activo         Boolean @default(true)

  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  detallesOrden DetalleOrden[]

  @@map("servicio")
}

/// Orden de trabajo (OT). Un ingreso del vehículo al taller, desde que se
/// recibe hasta que se entrega. Es el centro del sistema: de ella cuelgan los
/// detalles que se cobran, los presupuestos y la línea de tiempo que ve el
/// cliente.
model OrdenTrabajo {
  ordenTrabajoId     String      @id @default(uuid()) @map("orden_trabajo_id") @db.Uuid
  /// El número que usa el taller al hablar de la orden (OT-000123). Es
  /// correlativo, así que no se muestra al cliente: delataría cuántas órdenes
  /// hay.
  numero             Int         @unique @default(autoincrement())
  /// Aleatorio y no correlativo (AFM-7K3Q9X): no se puede adivinar uno a
  /// partir de otro.
  codigoSeguimiento  String      @unique @map("codigo_seguimiento") @db.VarChar(12)
  /// El cliente que trajo el vehículo, congelado al recibirlo: si el vehículo
  /// cambia de dueño, la orden sigue siendo de quien la pidió y pagó.
  clienteId          String      @map("cliente_id") @db.Uuid
  vehiculoId         String      @map("vehiculo_id") @db.Uuid
  /// El mecánico asignado. Vacío mientras el administrador no la asigna; un
  /// mecánico solo ve las órdenes donde figura aquí.
  mecanicoId         String?     @map("mecanico_id") @db.Uuid
  creadoPorId        String      @map("creado_por_id") @db.Uuid
  estado             EstadoOrden @default(RECIBIDO)
  /// En km. Se congela aquí porque el vehículo vuelve con otro en cada visita.
  kilometrajeIngreso Int         @map("kilometraje_ingreso")
  /// Lo que el cliente pide o reporta al dejar el vehículo, con sus palabras.
  motivo             String
  /// Lo que encontró el mecánico. Vacío hasta terminar el diagnóstico.
  diagnostico        String?
  /// Cuándo se le dijo al cliente que estaría listo; pasada esta fecha sin
  /// entregar, la orden figura como vencida.
  fechaPrometida     DateTime?   @map("fecha_prometida") @db.Date
  recibidaEn         DateTime    @default(now()) @map("recibida_en")
  /// Se llena al pasar a ENTREGADO.
  entregadaEn        DateTime?   @map("entregada_en")
  /// Se llenan al pasar a CANCELADO; el motivo es obligatorio en ese caso (lo
  /// valida el service).
  canceladaEn        DateTime?   @map("cancelada_en")
  motivoCancelacion  String?     @map("motivo_cancelacion")

  // Sin campos de totales: el total sale de los detalles. Guardarlo sería
  // tener dos verdades.

  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  cliente   Cliente  @relation(fields: [clienteId], references: [clienteId])
  vehiculo  Vehiculo @relation(fields: [vehiculoId], references: [vehiculoId])
  mecanico  Usuario? @relation("OrdenMecanico", fields: [mecanicoId], references: [usuarioId], onDelete: Restrict)
  creadoPor Usuario  @relation("OrdenCreadaPor", fields: [creadoPorId], references: [usuarioId])

  eventos      EventoOrden[]
  detalles     DetalleOrden[]
  presupuestos Presupuesto[]

  @@index([estado])
  @@index([mecanicoId])
  @@index([vehiculoId])
  @@index([clienteId])
  @@map("orden_trabajo")
}

/// Los estados por los que pasa una orden. Es un enum porque cada estado tiene
/// reglas en el código (quién puede moverla y a dónde), no solo un nombre.
enum EstadoOrden {
  RECIBIDO
  EN_DIAGNOSTICO
  /// Esperando que el cliente apruebe el presupuesto.
  ESPERANDO_APROBACION
  EN_REPARACION
  ESPERANDO_REPUESTOS
  /// Listo para recoger.
  LISTO
  ENTREGADO
  CANCELADO
}

/// Evento de la línea de tiempo. Cada cambio de estado o nota de una orden, con
/// quién y cuándo. Es lo que el cliente lee en su portal (solo los públicos) y
/// lo que el taller revisa cuando algo salió mal. No se edita ni se borra: es
/// un historial.
model EventoOrden {
  eventoOrdenId  String       @id @default(uuid()) @map("evento_orden_id") @db.Uuid
  ordenTrabajoId String       @map("orden_trabajo_id") @db.Uuid
  /// El estado al que pasó la orden. Vacío si el evento es solo una nota.
  estado         EstadoOrden?
  nota           String?
  /// Si lo ve el cliente en su portal. Una nota interna («el cliente discutió
  /// el precio») no sale del taller.
  esPublico      Boolean      @default(false) @map("es_publico")
  /// Quién lo hizo. Vacío cuando fue el cliente desde su portal (el cliente
  /// no es un usuario): hoy, al responder un presupuesto.
  creadoPorId    String?      @map("creado_por_id") @db.Uuid

  creadoEn DateTime @default(now()) @map("creado_en")
  // Sin actualizadoEn: un evento no se edita.

  // Cascade: los eventos no tienen sentido sin su orden.
  ordenTrabajo OrdenTrabajo @relation(fields: [ordenTrabajoId], references: [ordenTrabajoId], onDelete: Cascade)
  // Restrict: un usuario con historial no se borra (se desactiva); que el
  // autor sea opcional no lo cambia.
  creadoPor    Usuario?     @relation(fields: [creadoPorId], references: [usuarioId], onDelete: Restrict)

  @@index([ordenTrabajoId, creadoEn])
  @@map("evento_orden")
}

/// Detalle de la orden: lo que se hace y se cobra, un servicio (mano de obra) o
/// un repuesto. La suma de los detalles es el total de la orden.
model DetalleOrden {
  detalleOrdenId String      @id @default(uuid()) @map("detalle_orden_id") @db.Uuid
  ordenTrabajoId String      @map("orden_trabajo_id") @db.Uuid
  tipo           TipoDetalle
  /// Obligatorio si `tipo` es SERVICIO y vacío si es PRODUCTO (lo valida el
  /// service). Opcional en la base porque un detalle es una cosa o la otra.
  servicioId     String?     @map("servicio_id") @db.Uuid
  /// Obligatorio si `tipo` es PRODUCTO y vacío si es SERVICIO (lo valida el
  /// service). Al agregarlo se descuenta el stock (MovimientoStock).
  productoId     String?     @map("producto_id") @db.Uuid
  /// Copiada del catálogo o del producto al agregar el detalle, y editable: lo
  /// que se cobra no cambia si después se renombra el original.
  descripcion    String      @db.VarChar(200)
  /// En la unidad del producto (litros, unidades…); en un servicio, cuántas
  /// veces se hace (normalmente 1).
  cantidad       Decimal     @db.Decimal(10, 2)
  /// En soles, congelado al agregar el detalle: subir el precio del catálogo no
  /// cambia órdenes ya armadas.
  precioUnitario Decimal     @map("precio_unitario") @db.Decimal(10, 2)
  /// Costo del repuesto al consumirlo, en soles, congelado. Solo en PRODUCTO;
  /// sirve para el margen y nunca se muestra al cliente.
  costoUnitario  Decimal?    @map("costo_unitario") @db.Decimal(10, 2)

  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  // Cascade: un detalle no existe fuera de su orden.
  ordenTrabajo    OrdenTrabajo     @relation(fields: [ordenTrabajoId], references: [ordenTrabajoId], onDelete: Cascade)
  servicio        Servicio?        @relation(fields: [servicioId], references: [servicioId], onDelete: Restrict)
  producto        Producto?        @relation(fields: [productoId], references: [productoId], onDelete: Restrict)
  movimientoStock MovimientoStock?

  @@index([ordenTrabajoId])
  @@index([productoId])
  @@map("detalle_orden")
}

/// Qué clase de detalle es. Un enum porque cambia de dónde sale el precio y si
/// mueve stock.
enum TipoDetalle {
  /// Mano de obra.
  SERVICIO
  /// Repuesto o insumo.
  PRODUCTO
}

/// Lo que el taller le propone al cliente antes de reparar. Cada envío es una
/// versión nueva y congelada: si aparece otro problema a mitad de la reparación
/// se envía otra, y la anterior queda en el historial. El cliente responde
/// desde su portal o el administrador registra su respuesta.
model Presupuesto {
  presupuestoId  String            @id @default(uuid()) @map("presupuesto_id") @db.Uuid
  ordenTrabajoId String            @map("orden_trabajo_id") @db.Uuid
  /// 1, 2, 3… dentro de cada orden.
  version        Int
  estado         EstadoPresupuesto @default(PENDIENTE)
  /// En soles. Redundancia deliberada: congela el total que vio el cliente,
  /// aunque los detalles de la orden cambien después.
  total          Decimal           @db.Decimal(10, 2)
  enviadoPorId   String            @map("enviado_por_id") @db.Uuid
  enviadoEn      DateTime          @default(now()) @map("enviado_en")
  /// El administrador que registró la respuesta del cliente. Vacío mientras
  /// está PENDIENTE y cuando el cliente respondió desde su portal (canal
  /// PORTAL): el cliente no es un usuario. Los campos de la decisión se llenan
  /// juntos.
  decididoPorId  String?           @map("decidido_por_id") @db.Uuid
  decididoEn     DateTime?         @map("decidido_en")
  /// Por dónde respondió el cliente.
  canalDecision  CanalDecision?    @map("canal_decision")
  notaDecision   String?           @map("nota_decision")

  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  ordenTrabajo OrdenTrabajo         @relation(fields: [ordenTrabajoId], references: [ordenTrabajoId])
  enviadoPor   Usuario              @relation("PresupuestoEnviadoPor", fields: [enviadoPorId], references: [usuarioId])
  decididoPor  Usuario?             @relation("PresupuestoDecididoPor", fields: [decididoPorId], references: [usuarioId], onDelete: Restrict)
  detalles     DetallePresupuesto[]

  @@unique([ordenTrabajoId, version])
  @@map("presupuesto")
}

/// En qué quedó un presupuesto.
enum EstadoPresupuesto {
  /// Esperando la respuesta del cliente.
  PENDIENTE
  APROBADO
  RECHAZADO
  /// Se envió una versión nueva antes de decidir esta.
  REEMPLAZADO
}

/// Por dónde llegó la respuesta del cliente a un presupuesto.
enum CanalDecision {
  /// Llamada telefónica.
  TELEFONO
  WHATSAPP
  /// En persona, en el taller.
  EN_PERSONA
  /// Desde su portal. Lo registra el propio cliente, no el administrador.
  PORTAL
}

/// Detalle del presupuesto: una foto de un detalle de la orden en el momento de
/// enviar el presupuesto. No apunta al detalle vivo a propósito: si la orden
/// cambia, el presupuesto tiene que seguir diciendo lo que se propuso.
model DetallePresupuesto {
  detallePresupuestoId String      @id @default(uuid()) @map("detalle_presupuesto_id") @db.Uuid
  presupuestoId        String      @map("presupuesto_id") @db.Uuid
  tipo                 TipoDetalle
  descripcion          String      @db.VarChar(200)
  cantidad             Decimal     @db.Decimal(10, 2)
  /// En soles.
  precioUnitario       Decimal     @map("precio_unitario") @db.Decimal(10, 2)

  creadoEn DateTime @default(now()) @map("creado_en")
  // Sin actualizadoEn: es una foto, no se edita.

  // Cascade: el detalle no existe fuera de su presupuesto.
  presupuesto Presupuesto @relation(fields: [presupuestoId], references: [presupuestoId], onDelete: Cascade)

  @@index([presupuestoId])
  @@map("detalle_presupuesto")
}
