/// Español: repuesto o insumo. Lo que el taller compra, guarda y consume en las
/// órdenes (filtros, aceite, pastillas de freno…). Lleva stock para saber qué
/// falta antes de que un auto quede parado esperándolo.
model Product {
  productId String        @id @default(uuid()) @map("product_id") @db.Uuid
  /// Código interno o del fabricante; es lo que se busca en el mostrador.
  code      String        @unique @db.VarChar(30)
  name      String        @db.VarChar(150)
  kind      ProductKind
  unit      UnitOfMeasure
  brand     String?       @db.VarChar(60)
  /// En la unidad del producto. Redundancia deliberada: es la suma de sus
  /// movimientos, guardada para no recorrer el kardex en cada consulta. Se
  /// actualiza en la misma transacción que crea el movimiento.
  stock     Decimal       @default(0) @db.Decimal(10, 2)
  /// Español: stock mínimo. Por debajo de este valor el producto sale en la
  /// alerta de stock bajo.
  minStock  Decimal       @default(0) @map("min_stock") @db.Decimal(10, 2)
  /// Último costo de compra, en soles. Se copia al ítem de la orden al
  /// consumirlo, para que el margen no cambie con la siguiente compra.
  cost      Decimal       @db.Decimal(10, 2)
  /// Español: precio de venta al cliente, en soles.
  price     Decimal       @db.Decimal(10, 2)
  /// No se borra si tiene movimientos: se desactiva y deja de ofrecerse.
  isActive  Boolean       @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  movements      StockMovement[]
  workOrderItems WorkOrderItem[]

  @@index([name])
  @@map("inventory_product")
}

/// Si el producto es una pieza que se cambia o algo que se gasta. Sirve para
/// filtrar y para los reportes; los dos se manejan igual en stock.
enum ProductKind {
  /// Español: repuesto.
  PART
  /// Español: insumo.
  SUPPLY
}

/// Español: unidad de medida. Un enum corto porque un taller usa pocas, y una
/// lista cerrada evita «lt», «litro» y «L» para lo mismo.
enum UnitOfMeasure {
  /// Español: unidad.
  UNIT
  /// Español: litro.
  LITER
  /// Español: galón.
  GALLON
  KIT
  /// Español: metro.
  METER
}

/// Español: movimiento de stock, kardex. Cada entrada o salida de un producto,
/// con su motivo. El stock de Product es la suma de estos movimientos; el
/// kardex es lo que explica por qué el número es ese. No se edita ni se borra:
/// un error se corrige con un ajuste.
model StockMovement {
  stockMovementId String            @id @default(uuid()) @map("stock_movement_id") @db.Uuid
  productId       String            @map("product_id") @db.Uuid
  type            StockMovementType
  /// Con signo, en la unidad del producto: positivo entra, negativo sale.
  quantity        Decimal           @db.Decimal(10, 2)
  /// Costo unitario en soles. Obligatorio en PURCHASE (actualiza Product.cost);
  /// en las salidas es el costo con que salió.
  unitCost        Decimal?          @map("unit_cost") @db.Decimal(10, 2)
  /// La salida que generó un repuesto agregado a una orden. Único: un ítem
  /// mueve stock una sola vez. Obligatorio si `type` es WORK_ORDER (lo valida
  /// el service).
  workOrderItemId String?           @unique @map("work_order_item_id") @db.Uuid
  note            String?
  createdById     String            @map("created_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  // Sin updatedAt: un movimiento no se edita.

  product       Product        @relation(fields: [productId], references: [productId])
  // SetNull: si el ítem se quita de la orden, su salida se revierte con otro
  // movimiento y este queda en el kardex como lo que fue.
  workOrderItem WorkOrderItem? @relation(fields: [workOrderItemId], references: [workOrderItemId], onDelete: SetNull)
  createdBy     User           @relation(fields: [createdById], references: [userId])

  @@index([productId, createdAt])
  @@map("inventory_stock_movement")
}

/// Por qué se movió el stock.
enum StockMovementType {
  /// Español: compra. Entrada de mercadería.
  PURCHASE
  /// Español: consumo en una orden de trabajo.
  WORK_ORDER
  /// Español: ajuste. Inventario físico, merma o corrección de un error.
  ADJUSTMENT
}

/// Español: herramienta. Lo que el taller tiene y presta a sus mecánicos, pero
/// no se consume: por eso no lleva stock, sino estado y quién la tiene.
model Tool {
  toolId       String     @id @default(uuid()) @map("tool_id") @db.Uuid
  code         String     @unique @db.VarChar(30)
  name         String     @db.VarChar(150)
  brand        String?    @db.VarChar(60)
  status       ToolStatus @default(AVAILABLE)
  /// El mecánico que la tiene ahora. Vacío si está en el almacén. Sin
  /// historial de préstamos en el MVP.
  assignedToId String?    @map("assigned_to_id") @db.Uuid
  notes        String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  assignedTo User? @relation(fields: [assignedToId], references: [userId], onDelete: Restrict)

  @@index([assignedToId])
  @@map("inventory_tool")
}

/// En qué condición está una herramienta.
enum ToolStatus {
  /// Español: operativa.
  AVAILABLE
  /// Español: en reparación.
  IN_REPAIR
  /// Español: de baja. Ya no se usa, pero queda registrada.
  RETIRED
}
