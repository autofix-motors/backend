/// Repuesto o insumo. Lo que el taller compra, guarda y consume en las órdenes
/// (filtros, aceite, pastillas de freno…). Lleva stock para saber qué falta
/// antes de que un auto quede parado esperándolo.
model Producto {
  productoId  String       @id @default(uuid()) @map("producto_id") @db.Uuid
  /// Código interno o del fabricante; es lo que se busca en el mostrador.
  codigo      String       @unique @db.VarChar(30)
  nombre      String       @db.VarChar(150)
  tipo        TipoProducto
  unidad      UnidadMedida
  marca       String?      @db.VarChar(60)
  /// En la unidad del producto. Redundancia deliberada: es la suma de sus
  /// movimientos, guardada para no recorrer el kardex en cada consulta. Se
  /// actualiza en la misma transacción que crea el movimiento.
  stock       Decimal      @default(0) @db.Decimal(10, 2)
  /// Por debajo de este valor el producto sale en la alerta de stock bajo.
  stockMinimo Decimal      @default(0) @map("stock_minimo") @db.Decimal(10, 2)
  /// Último costo de compra, en soles. Se copia al detalle de la orden al
  /// consumirlo, para que el margen no cambie con la siguiente compra.
  costo       Decimal      @db.Decimal(10, 2)
  /// Precio de venta al cliente, en soles.
  precio      Decimal      @db.Decimal(10, 2)
  /// Inactivo: deja de ofrecerse. Con movimientos la base no deja borrarlo.
  activo      Boolean      @default(true)

  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  movimientos   MovimientoStock[]
  detallesOrden DetalleOrden[]

  @@index([nombre])
  @@map("producto")
}

/// Si el producto es una pieza que se cambia o algo que se gasta. Sirve para
/// filtrar; los dos se manejan igual en stock.
enum TipoProducto {
  REPUESTO
  INSUMO
}

/// Un enum corto porque un taller usa pocas unidades, y una lista cerrada evita
/// «lt», «litro» y «L» para lo mismo.
enum UnidadMedida {
  UNIDAD
  LITRO
  GALON
  KIT
  METRO
}

/// Kardex: cada entrada o salida de un producto, con su motivo. El stock de
/// Producto es la suma de estos movimientos; el kardex es lo que explica por
/// qué el número es ese. No se edita ni se borra: un error se corrige con un
/// ajuste.
model MovimientoStock {
  movimientoStockId String         @id @default(uuid()) @map("movimiento_stock_id") @db.Uuid
  productoId        String         @map("producto_id") @db.Uuid
  tipo              TipoMovimiento
  /// Con signo, en la unidad del producto: positivo entra, negativo sale.
  cantidad          Decimal        @db.Decimal(10, 2)
  /// Costo unitario en soles. Obligatorio en COMPRA (actualiza Producto.costo);
  /// en las salidas es el costo con que salió.
  costoUnitario     Decimal?       @map("costo_unitario") @db.Decimal(10, 2)
  /// La salida que generó un repuesto agregado a una orden. Único: un detalle
  /// mueve stock una sola vez. Obligatorio en la salida ORDEN_TRABAJO (lo
  /// valida el service); la devolución de un detalle quitado es ORDEN_TRABAJO
  /// sin detalle, con la orden en la nota.
  detalleOrdenId    String?        @unique @map("detalle_orden_id") @db.Uuid
  nota              String?
  creadoPorId       String         @map("creado_por_id") @db.Uuid

  creadoEn DateTime @default(now()) @map("creado_en")
  // Sin actualizadoEn: un movimiento no se edita.

  producto     Producto      @relation(fields: [productoId], references: [productoId])
  // SetNull: si el detalle se quita de la orden, su salida se revierte con
  // otro movimiento y este queda en el kardex como lo que fue.
  detalleOrden DetalleOrden? @relation(fields: [detalleOrdenId], references: [detalleOrdenId], onDelete: SetNull)
  creadoPor    Usuario       @relation(fields: [creadoPorId], references: [usuarioId])

  @@index([productoId, creadoEn])
  @@map("movimiento_stock")
}

/// Por qué se movió el stock.
enum TipoMovimiento {
  /// Entrada de mercadería.
  COMPRA
  /// Consumo en una orden de trabajo.
  ORDEN_TRABAJO
  /// Inventario físico, merma o corrección de un error.
  AJUSTE
}
