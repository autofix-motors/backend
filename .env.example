# Copia este archivo a .env y completa los valores. El .env no se commitea.

NODE_ENV=development
PORT=3001

# Conexión a PostgreSQL. La usan la API (vía @nestjs/config) y la CLI de Prisma
# (vía prisma.config.ts).
DATABASE_URL="postgresql://usuario:contrasena@localhost:5432/autofix_motors?schema=public"

# Autenticación. JWT_SECRET firma los tokens de acceso: al menos 32 caracteres,
# distinto en cada ambiente. Se genera con:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# Solo para el seed (pnpm db:seed): si están las dos, crea el primer
# administrador. Si el usuario ya existe, no le cambia la contraseña.
# Se pueden borrar del entorno después de sembrar.
ADMIN_EMAIL=
ADMIN_PASSWORD=
